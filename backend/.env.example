# Application Secret Key - Change this in production!
SECRET_KEY=your-secret-key-change-this-in-production

# MongoDB Connection URI
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/CVACare?retryWrites=true&w=majority

# Application Port
PORT=5000

# Flask Debug Mode (True for development, False for production)
FLASK_DEBUG=True

# Frontend URL for CORS (used in production)
FRONTEND_URL=https://your-frontend.vercel.app

# Optional: comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-frontend.vercel.app

# Firebase Admin credentials for server-side auth verification
# Option 1: path to service account JSON file (recommended for local dev)
FIREBASE_SERVICE_ACCOUNT_PATH=./cvaped-fa8b2-firebase-adminsdk-fbsvc-92b2666b41.json
# Option 2: raw JSON string of service account (recommended for cloud deploys)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Cloudinary Configuration (for image uploads)
# Get your credentials from https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: local mDNS service for ESP32 discovery (disable on Cloud Run)
ENABLE_MDNS=True

# Optional: shared token for ESP32 or gateway posts to /api/wearable/data
WEARABLE_INGEST_TOKEN=change-this-shared-token

# Optional: how long the latest wearable payload stays fresh for live polling
WEARABLE_LATEST_MAX_AGE_SECONDS=300

# Optional: Gunicorn tuning for container deployments
GUNICORN_WORKERS=1
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=0
